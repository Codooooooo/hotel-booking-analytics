        <Configuration>
          <FormulaFields>
            <FormulaField expression="IF [market_segment] = &quot;Direct&quot; THEN &quot;Direct booking made by the customer&quot;&#10;ELSEIF [market_segment] = &quot;Corporate&quot; THEN &quot;Corporate clients, business-related bookings&quot;&#10;ELSEIF [market_segment] = &quot;Online TA&quot; THEN &quot;Booking made via an Online Travel Agent&quot;&#10;ELSEIF [market_segment] = &quot;Offline TA/TO&quot; THEN &quot;Booking made via an Offline Travel Agent or Tour Operator&quot;&#10;ELSEIF [market_segment] = &quot;Complementary&quot; THEN &quot;Complimentary booking with no charge&quot;&#10;ELSEIF [market_segment] = &quot;Groups&quot; THEN &quot;Group booking, often for conferences or events&quot;&#10;ELSEIF [market_segment] = &quot;Undefined&quot; THEN &quot;Uncategorized or undefined market segment&quot;&#10;ELSEIF [market_segment] = &quot;Aviation&quot; THEN &quot;Bookings made by aviation-related clients&quot;&#10;ELSE &quot;Other&quot;&#10;ENDIF&#10;" field="market_segment_description" size="1073741823" type="V_WString" enabled="true" />
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText>market_segment_description = IF [market_segment] = "Direct" THEN "Direct booking...</DefaultAnnotationText>
          <Left value="False" />
        </Annotation>
